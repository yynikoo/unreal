# Copy to .env.local for local runs; set the same variables in Vercel → Project → Settings → Environment Variables.

# Secret used to sign the session cookie. REQUIRED in production, at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Set to "1" to turn off the built-in demo accounts (see lib/demo-users.ts).
DISABLE_DEMO_USERS=
